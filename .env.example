# Lab Arista EOS (group arista_lab).
ANSIBLE_USER_LAB=
ANSIBLE_PASSWORD_LAB=
ANSIBLE_BECOME_PASSWORD_LAB=

# Prod Arista + Junos (groups arista_prod, juniper_prod). One LDAP account.
ANSIBLE_USER=
ANSIBLE_PASSWORD=
ANSIBLE_BECOME_PASSWORD=

# Used when the Batfish service is added to Compose later.
BATFISH_HOST=127.0.0.1
BATFISH_PORT=9996

# GitLab PAT (read_repository) for https://gitlab.hybrid.ai/network/backups/us
GITLAB_BACKUP_TOKEN=

# Lab Junos NETCONF (group juniper_lab). Empty = fall back to ANSIBLE_USER_LAB / ANSIBLE_PASSWORD_LAB.
JUNOS_USER=
JUNOS_PASSWORD=
